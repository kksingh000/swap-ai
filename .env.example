# =============================================================================
# SwapCircle AI Voice Sales Agent - environment
# Copy to .env and edit. EVERY line below is optional: with no .env at all the
# app runs in fully FREE deterministic mode (rules NLU + template replies +
# trained classifier + mock telephony + simulated WhatsApp).
# =============================================================================

# ---------- App --------------------------------------------------------------
ENV=development
DEBUG=true
# Public URL Twilio can reach. Use your ngrok https URL when testing real calls.
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Database ---------------------------------------------------------
# FREE: SQLite locally. Swap for Postgres in production (Neon/Supabase free tier).
DATABASE_URL=sqlite:///./swap_agent.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/swapagent

# ---------- LLM --------------------------------------------------------------
# auto | rules | ollama | huggingface | openai_compatible
#   auto  -> picks the best configured option, falls back to `rules`
#   rules -> FREE, no model at all: deterministic NLU + template replies
LLM_PROVIDER=auto

# FREE - fully local. Install Ollama, then: ollama pull qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# FREE TIER - Hugging Face Inference router (OpenAI-compatible)
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1

# FREE TIER - Groq is the recommended hosted option: fast and generous limits.
# Also works with OpenRouter, Together, LM Studio, vLLM or OpenAI.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# ---------- Telephony --------------------------------------------------------
# mock  = FREE, no real calls (browser demo mode is the "line")
# twilio = PAID per minute; trial credit is enough for testing
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE=Polly.Aditi
TWILIO_STT_LANGUAGE=en-IN

# ---------- WhatsApp ---------------------------------------------------------
# mock   = FREE, rendered in the dashboard's WhatsApp simulator
# twilio = FREE TIER via the Twilio WhatsApp sandbox (recipient must opt in)
WHATSAPP_PROVIDER=mock
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
CATALOG_URL=https://swapcircle.example/catalog

# ---------- Speech -----------------------------------------------------------
# browser = FREE: Web Speech API runs on the user's device (default)
# faster_whisper / piper = FREE but local CPU, needs extra installs
STT_PROVIDER=browser
TTS_PROVIDER=browser
WHISPER_MODEL=base
PIPER_VOICE=

# ---------- Lead scoring ensemble --------------------------------------------
ENSEMBLE_WEIGHT_RULES=0.5
ENSEMBLE_WEIGHT_ML=0.3
ENSEMBLE_WEIGHT_LLM=0.2

# ---------- Scheduling -------------------------------------------------------
TIMEZONE=Asia/Kolkata
SCHEDULER_ENABLED=true

# ---------- Store defaults (also editable at runtime in Settings) ------------
STORE_NAME=SwapCircle
STORE_LOCATION=Delhi NCR
AGENT_NAME=Ananya
